{
  "name": "planner",
  "productName": "Planner",
  "version": "1.0.0",
  "description": "Interaktiv tidsregistrering med automatisk opfangning af aktive programmer og dokumenter.",
  "main": "./out/main/index.js",
  "author": "MarcusSkovbaek",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts --port 4173 --strictPort",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "update:keygen": "node scripts/update-keygen.mjs",
    "update:sign": "node scripts/sign-update.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "~4.0.18",
    "zustand": "^5.0.0"
  }
}
